@startuml
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontName SansSerif
skinparam wrapWidth 180
actor "Guest" as Guest
actor "Registered user" as User
actor "Administrator" as Admin
actor "External AI provider" as AI
User --|> Guest
Admin --|> User
rectangle "SmartLoo" {
  usecase "UC-01 / FR-01\nFind nearby open toilets" as U1
  usecase "UC-02 / FR-02\nFilter amenities and pricing" as U2
  usecase "UC-09 / FR-09\nBrowse map and facility details" as U9
  usecase "UC-08 / FR-08\nRegister and sign in" as U8
  usecase "UC-03 / FR-03\nCreate/edit/delete own review" as U3
  usecase "UC-04 / FR-04\nRead AI summary and\npreference recommendations" as U4
  usecase "UC-05 / FR-05\nSuggest a new facility" as U5a
  usecase "UC-05 / FR-05\nApprove/reject suggestions" as U5b
  usecase "UC-06 / FR-06\nInspect date-filtered analytics" as U6
  usecase "UC-07 / FR-07\nImport facilities / export reports" as U7
  usecase "UC-10 / FR-10\nDelete own account" as U10a
  usecase "UC-10 / FR-10\nClose a facility; retain reviews" as U10b
}
Guest -- U1
Guest -- U2
Guest -- U9
Guest -- U8
Guest -- U4 : summaries
User -- U4 : recommendations
User -- U3
User -- U5a
User -- U10a
Admin -- U5b
Admin -- U6
Admin -- U7
Admin -- U10b
AI -- U4 : generate when available
@enduml

# One public service: existing React app and FastAPI API on the same origin.
ARG NODE_IMAGE=node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
ARG PYTHON_IMAGE=python:3.13.14-slim@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6
FROM ${NODE_IMAGE} AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm test && npm run build

FROM ${PYTHON_IMAGE}
ARG VCS_REF=unversioned
LABEL org.opencontainers.image.source="https://github.com/akcedia/SmartLoo" \
      org.opencontainers.image.revision="${VCS_REF}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements-runtime.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.2 \
    && python -m pip install --no-cache-dir -r requirements-runtime.txt \
    && python -m pip check \
    && useradd --uid 10001 --create-home smartloo
COPY --chown=10001:10001 src ./src
COPY --from=frontend --chown=10001:10001 /build/frontend/dist ./web
USER 10001:10001
EXPOSE 8000
# Render supplies PORT. One worker fits the free plan's small memory allocation.
CMD ["sh","-c","exec python -m uvicorn src.cloud_app:create_cloud_app --factory --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log"]
